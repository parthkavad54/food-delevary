{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm install && cd backend && npm install && cd .. && npm run build",
  "outputDirectory": "public",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    }
  ]
}
