{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm install && cd backend && npm install && cp -r frontend/* public/ || xcopy frontend public /E /Y",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)\\..*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
